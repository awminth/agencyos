{
  "name": "agency-ms-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server.ts",
    "dev:frontend": "npm run dev --prefix ../frontend",
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run dev:server\" \"npm run dev:frontend\"",
    "build": "node scripts/prepare-dist.js",
    "start": "node server.js",
    "init-db": "tsx scripts/init-db.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mysql2": "^3.12.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
